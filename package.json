{
	"name": "roamer",
	"version": "0.1.0-beta.9",
	"description": "An outliner experience for Obsidian, in the spirit of RemNote, Roam Research and Logseq.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env.local esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node --env-file-if-exists=.env.local esbuild.config.mjs production",
		"version": "jiti scripts/release.ts bump && git add manifest.json versions.json",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc -noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:mutation": "stryker run",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage",
		"prepare": "husky",
		"commitlint": "commitlint",
		"release:verify": "jiti scripts/release.ts verify",
		"release:prerelease": "jiti scripts/release.ts prerelease",
		"release:notes": "jiti scripts/release.ts notes",
		"test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^9.39.4",
		"@lezer/common": "^1.5.3",
		"@lezer/markdown": "^1.8.0",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@types/node": "^22.15.17",
		"@types/ws": "^8.18.2",
		"@vitest/coverage-v8": "~4.0.18",
		"@vitest/eslint-plugin": "^1.6.27",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"jiti": "^2.6.1",
		"obsidian": "^1.14.4",
		"prettier": "^3.9.10",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "~4.0.18",
		"ws": "^8.22.0"
	},
	"engines": {
		"node": ">=22.12"
	}
}
